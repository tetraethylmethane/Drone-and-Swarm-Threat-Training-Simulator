# Drikr Systems training simulator - configuration template.
# Copy to .env and replace every value marked CHANGE. Never commit .env.
# All variables are validated at startup; the API refuses to start with invalid values.

# --- Deployment -------------------------------------------------------------
# development | test | production. Production enforces secure cookies and rejects dev credentials.
DRIKR_ENVIRONMENT=production

# --- Database (PostgreSQL only) --------------------------------------------
POSTGRES_DB=drikr
POSTGRES_USER=drikr
# CHANGE: long random password, e.g. output of: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE-to-a-long-random-password
# Owner connection: used only for migrations and to provision the API role. Must match the values above.
# Host "db" is the compose service name.
DRIKR_MIGRATION_DATABASE_URL=postgresql+psycopg://drikr:CHANGE-to-a-long-random-password@db:5432/drikr
# The API runs as this least-privilege role (created automatically at start). CHANGE the password to
# a different long random value. It cannot alter the schema or rewrite audit records or scores.
# (Setting this to the owner URL instead keeps the old behaviour; System health then reports it.)
DRIKR_DATABASE_URL=postgresql+psycopg://drikr_app:CHANGE-to-a-different-long-random-password@db:5432/drikr

# --- Secrets -----------------------------------------------------------------
# CHANGE: at least 32 random characters. Rotating it signs every user out.
DRIKR_SECRET_KEY=CHANGE-generate-with-python-secrets-token-urlsafe-48

# --- Sessions and cookies ----------------------------------------------------
DRIKR_SESSION_TTL_MINUTES=480
DRIKR_SESSION_IDLE_MINUTES=60
# Keep true whenever the web UI is served over HTTPS. Set false only for
# plain-HTTP access on an isolated training network (documented risk).
DRIKR_COOKIE_SECURE=true
# The API is only reachable through the bundled reverse proxy in docker-compose.yml.
DRIKR_TRUST_PROXY_HEADERS=true

# --- Abuse prevention --------------------------------------------------------
DRIKR_LOGIN_RATE_LIMIT_PER_MINUTE=10
DRIKR_LOCKOUT_THRESHOLD=5
DRIKR_LOCKOUT_MINUTES=15

# --- Exercise clock ----------------------------------------------------------
# Seconds without a client poll before a running exercise is paused (connection_lost).
DRIKR_HEARTBEAT_GRACE_S=15
DRIKR_SWEEPER_INTERVAL_S=10
# Admission control: the most exercises active at once (running, or created in the last 10 minutes).
# SET THIS from a load test on this server (tests/load/run.sh; docs/testing/load-resilience-report.md).
# Further trainees get "server at capacity, try again in a minute" instead of slowing everyone down.
# 0 disables the limit.
DRIKR_MAX_ACTIVE_SESSIONS=0

DRIKR_LOG_LEVEL=INFO

# --- Web ---------------------------------------------------------------------
# Host port for the web UI (nginx).
DRIKR_WEB_PORT=8080
# HTTPS host port, used with docker-compose.tls.yml (HTTP then only redirects).
DRIKR_HTTPS_PORT=8443

# --- Optional: demonstration users --------------------------------------------
# Only used by "drikr-api seed-demo --with-demo-users". Leave empty in production.
DRIKR_DEMO_PASSWORD=
